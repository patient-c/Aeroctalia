{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#1B2A3D",
          "foreground": "#8ED1F7",
          "style": "powerline",
          "template": "{{ if .WSL }}WSL at{{ end }} {{.Icon}} ",
          "type": "os"
        },
        {
          "background": "#4A9FD8",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "full"
          },
          "style": "powerline",
          "template": " \uf07b {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#5FC9A3",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#F4A261{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#E76F51{{ end }}",
            "{{ if gt .Ahead 0 }}#5FC9A3{{ end }}",
            "{{ if gt .Behind 0 }}#4A9FD8{{ end }}"
          ],
          "foreground": "#0F1F2E",
          "leading_diamond": "\ue0b6",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "branch_icon": "\uE0A0 ",
            "branch_identical_icon": "\u25CF"
          },
          "style": "powerline",
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "git"
        },
        {
          "background": "#74B9FF",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "go"
        },
        {
          "background": "#B0E0E6",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "background": "#7ED6B8",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " \ue718 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "node"
        },
        {
          "background": "#E8A87C",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_version": true
          },
          "style": "powerline",
          "template": " \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "rust"
        },
        {
          "background_templates": [
            "{{if contains \"default\" .Profile}}#4A9FD8{{end}}",
            "{{if contains \"jan\" .Profile}}#E76F51{{end}}"
          ],
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_default": false
          },
          "style": "powerline",
          "template": " \ue7ad {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "type": "aws"
        },
        {
          "background": "#FFE066",
          "foreground": "#0F1F2E",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0ad ",
          "type": "root"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#B19CD9",
          "foreground": "#0F1F2E",
          "invert_powerline": true,
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "style": "diamond",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          },
          "type": "time"
        },
        {
          "background": "#E76F51",
          "foreground": "#FDF6EC",
          "invert_powerline": true,
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "style": "diamond",
          "options": {
            "always_enabled": false
          },
          "template": " \uf00d {{ .Code }} ",
          "type": "exit"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#4A9FD8",
          "style": "plain",
          "template": "\u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "final_space": true,
  "version": 4
}