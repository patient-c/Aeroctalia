// ~/.config/fastfetch/config.jsonc
// Tema "Frutiger Aero" minimalista: pocos datos, pensado para una
// ventana kitty chica (~800x500px). El logo se define aparte
// (ver random-logo.sh) para poder rotar tus PNG.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        // Fallback por si ejecutás fastfetch directo, sin pasar por el
        // script de logo aleatorio. Achicado para que quepa cómodo en
        // una ventana de 800x500.
        "type": "kitty",
        "width": 16,
        "height": 9,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "38;5;51",
                "at": "38;5;255",
                "host": "38;5;45"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;45m────────────────────\u001b[0m"
        },
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "38;5;51"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "38;5;51"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "38;5;51"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "38;5;51"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "38;5;51",
            "format": "{1}"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM",
            "keyColor": "38;5;51"
        },
        {
            "type": "disk",
            "key": "󰨣 Disk",
            "keyColor": "38;5;51"
        },
        {
            "type": "custom",
            "format": "\u001b[38;5;45m────────────────────\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
